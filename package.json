{
  "name": "testcase-skill",
  "private": true,
  "type": "module",
  "description": "Pruebas de la skill testcase. La skill en sí (testcase/) no tiene dependencias.",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.ts\"",
    "test:unit": "node --test --test-concurrency=1 \"tests/unit-*.test.ts\"",
    "test:e2e": "node --test \"tests/e2e.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:screenshots": "node docs/screenshots.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "playwright": "1.63.0",
    "typescript": "5.6.3"
  }
}
