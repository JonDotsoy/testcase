{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "testcase/scripts/*.ts", "testcase/assets/workspace/*.ts", "testcase/assets/workspace/examples/*.ts"]
}
